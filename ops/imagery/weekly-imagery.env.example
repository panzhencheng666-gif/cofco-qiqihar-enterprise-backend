# Public fallback. For the official Copernicus endpoint, replace these values
# and inject the account token through the protected production environment.
QIQIHAR_IMAGERY_STAC_URL=https://earth-search.aws.element84.com/v1/search
QIQIHAR_IMAGERY_COLLECTION=sentinel-2-c1-l2a
QIQIHAR_IMAGERY_ALLOWED_HOSTS=earth-search.aws.element84.com,s3.us-west-2.amazonaws.com,e84-earth-search-sentinel-data.s3.us-west-2.amazonaws.com
QIQIHAR_IMAGERY_MAX_CLOUD_PERCENT=30
QIQIHAR_IMAGERY_MIN_ZOOM=5
QIQIHAR_IMAGERY_MAX_ZOOM=14
QIQIHAR_IMAGERY_REQUEST_TIMEOUT_SECONDS=60
QIQIHAR_IMAGERY_COMMAND_TIMEOUT_SECONDS=18000
QIQIHAR_IMAGERY_MINIMUM_FREE_BYTES=6442450944
QIQIHAR_IMAGERY_RETENTION_COUNT=2
